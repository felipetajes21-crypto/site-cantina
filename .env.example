# Copie este arquivo para ".env" e ajuste os valores.

# Banco de dados. Desenvolvimento: SQLite (arquivo local). Produção: URL do PostgreSQL.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar as sessões (JWT). Em produção use um valor aleatório
# com pelo menos 32 caracteres. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-em-producao-0123456789"

# Usuário admin criado automaticamente pelo seed (se ainda não existir).
ADMIN_EMAIL="admin@cantina.local"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Cantina"

# Fuso horário usado para horário de funcionamento e relatórios.
APP_TIMEZONE="America/Sao_Paulo"

# Forma de pagamento padrão (pode ser trocada no painel, em Configurações):
#   static-pix = Pix com a chave da cantina, conferência manual
#   teste      = pagamento de teste (simula o PayPal, sem dinheiro; desligado em produção)
#   paypal     = PayPal (precisa das credenciais abaixo)
PAYMENT_PROVIDER="teste"

# PayPal: crie um app em https://developer.paypal.com (Apps & Credentials).
# Use PAYPAL_ENV="sandbox" para testar e "live" para cobrar de verdade.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# Endereço público do site (opcional; usado para o PayPal mandar o cliente de volta).
# Se vazio, o site usa o endereço da própria requisição.
APP_URL=""

# "false" impede que o seed crie os produtos de exemplo (útil em produção).
SEED_SAMPLE_DATA="true"
