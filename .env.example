# Copie este arquivo para ".env" e ajuste os valores.

# Banco de dados. Desenvolvimento: SQLite (arquivo local). Produção: URL do PostgreSQL.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar as sessões (JWT). Em produção use um valor aleatório
# com pelo menos 32 caracteres. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-em-producao-0123456789"

# Usuário admin criado automaticamente pelo seed (se ainda não existir).
ADMIN_EMAIL="admin@cantina.local"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Cantina"

# Fuso horário usado para horário de funcionamento e relatórios.
APP_TIMEZONE="America/Sao_Paulo"

# Provedor de pagamento. "static-pix" = Pix com a chave da cantina e confirmação
# manual no painel. Para integrar um gateway, veja src/lib/payments/.
PAYMENT_PROVIDER="static-pix"

# "false" impede que o seed crie os produtos de exemplo (útil em produção).
SEED_SAMPLE_DATA="true"
